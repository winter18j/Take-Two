{
  "expo": {
    "name": "Take Two",
    "slug": "taketwo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./resources/AppIcons (1)/appstore.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.walidsabhi.taketwo",
      "supportsTablet": true
    },
    "android": {
      "package": "com.walidsabhi.taketwo",
      "adaptiveIcon": {
        "foregroundImage": "./resources/AppIcons (1)/playstore.png",
        "backgroundColor": "#080B16"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./resources/AppIcons (1)/playstore.png"
    },
    "plugins": [
      "expo-audio",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5859429926694208~7889644634"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bef1fe58-aaf9-4222-b251-31bad8d602cc"
      }
    },
    "owner": "provavly"
  }
}
